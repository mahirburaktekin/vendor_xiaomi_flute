on early-boot

    chown system system /mnt/vendor/persist/sensors
    chown system system /mnt/vendor/persist/sensors/sns.reg
    chown system system /mnt/vendor/persist/sensors/sensors_list.txt
    chown system system /mnt/vendor/persist/sensors/registry
    chown system system /mnt/vendor/persist/sensors/registry/registry
    chown system system /mnt/vendor/persist/sensors/registry/registry/sensors_registry
    chown system system /mnt/vendor/persist/sensors/sensors_settings
    chown system system /mnt/vendor/persist/sensors/registry/sns_reg_config
    chown system system /mnt/vendor/persist/sensors/registry/sns_reg_version
    chown system system /mnt/vendor/persist/sensors/registry/config
    chmod 0664 /mnt/vendor/persist/sensors/sensors_settings
    chown system system /sys/kernel/boot_adsp/ssr

    rm /mnt/vendor/persist/sensors/registry/registry/volcano_default_sensors.json.default_sensors.sensor_temperature
    rm /mnt/vendor/persist/sensors/registry/registry/volcano_default_sensors.json.default_sensors.sensor_temperature.attr_0
    rm /mnt/vendor/persist/sensors/registry/registry/volcano_default_sensors.json.default_sensors.sensor_temperature.attr_1

    rm /mnt/vendor/persist/sensors/registry/registry/volcano_sx937x_0.json.sx937x
    rm /mnt/vendor/persist/sensors/registry/registry/volcano_sx937x_0.json.sx937x.patch_config
    rm /mnt/vendor/persist/sensors/registry/registry/volcano_sx937x_0.json.sx937x_0
    rm /mnt/vendor/persist/sensors/registry/registry/volcano_sx937x_0.json.sx937x_0.register_config
    rm /mnt/vendor/persist/sensors/registry/registry/volcano_sx937x_0.json.sx937x_0.sar
    rm /mnt/vendor/persist/sensors/registry/registry/volcano_sx937x_0.json.sx937x_0.sar.config
    rm /mnt/vendor/persist/sensors/registry/registry/volcano_sx937x_0.json.sx937x_0_platform
    rm /mnt/vendor/persist/sensors/registry/registry/volcano_sx937x_0.json.sx937x_0_platform.config
    rm /mnt/vendor/persist/sensors/registry/registry/volcano_sx937x_0.json.sx937x_0_platform.offset
    rm /mnt/vendor/persist/sensors/registry/registry/volcano_sx937x_0.json.sx937x_0_platform.placement
    rm /mnt/vendor/persist/sensors/registry/registry/volcano_sx937x_0.json.sx937x_0_platform.thresh

    rm /mnt/vendor/persist/sensors/registry/registry/sns_sar_algo.json.sar_algo
    rm /mnt/vendor/persist/sensors/registry/registry/sns_sar_algo.json.sar_algo.params
    rm /mnt/vendor/persist/sensors/registry/registry/sns_sar_algo.json.sar_algo.params_reg2
    rm /mnt/vendor/persist/sensors/registry/registry/sns_sar_algo_1.json.sar_algo_1
    rm /mnt/vendor/persist/sensors/registry/registry/sns_sar_algo_1.json.sar_algo_1.params
    rm /mnt/vendor/persist/sensors/registry/registry/sns_sar_algo_1.json.sar_algo_1.params_reg2
    rm /mnt/vendor/persist/sensors/registry/registry/sns_sar_algo_2.json.sar_algo_2
    rm /mnt/vendor/persist/sensors/registry/registry/sns_sar_algo_2.json.sar_algo_2.params
    rm /mnt/vendor/persist/sensors/registry/registry/sns_sar_algo_2.json.sar_algo_2.params_reg2

on post-fs-data && property:ro.build.type=userdebug
    #sensors log dir
    mkdir /data/vendor/sensors 0777 system system
    mkdir /data/vendor/sensors/scripts 0777 system system
    mkdir /data/vendor/sensors/diag_cfg 0770 system system
