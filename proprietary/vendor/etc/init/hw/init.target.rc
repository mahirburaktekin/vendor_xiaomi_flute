    restorecon /sys/module/migt/parameters/flt_target_delta

# Create xiaomi persist dir start
    mkdir /mnt/vendor/persist/camera
    chown system system /mnt/vendor/persist/camera
    chmod 0777 /mnt/vendor/persist/camera
# Create xiaomi persist dir end
  # Add init permission for com.xiaomi.mirror start
  chmod 0666 /dev/uhid
  # Add init permission for com.xiaomi.mirror end

on init 
    insmod /vendor/lib/modules/mi_schedule.ko
    insmod /vendor/lib/modules/metis.ko
    insmod /vendor/lib/modules/migt.ko

service fatal_err_check /vendor/bin/check_fatal_err.sh
    class late_start
    user root
    group root
    oneshot

on post-fs && property:ro.product.device=flute
    start mi-serial-sh
on property:ro.product.device=flute && property:ro.vendor.ril.oem.sno=*
    setprop ro.ril.oem.sno ${ro.vendor.ril.oem.sno}
on property:ro.product.device=flute && property:ro.vendor.ril.oem.psno=*
    setprop ro.ril.oem.psno ${ro.vendor.ril.oem.psno}
on property:ro.product.device=flute && property:ro.vendor.ril.oem.factory_id=*
    setprop ro.ril.factory_id ${ro.vendor.ril.oem.factory_id}
on property:ro.vendor.ril.oem.btmac=*
    setprop ro.ril.oem.btmac ${ro.vendor.ril.oem.btmac}
on property:ro.vendor.ril.oem.wifimac=*
    setprop ro.ril.oem.wifimac ${ro.vendor.ril.oem.wifimac}

#add for wifi 9434 log
service vendor.tcpdump /vendor/bin/tcpdump_vendor -i any -W 2 -C 2 -s 134 -w /data/vendor/wlan_logs/tcpdump.pcap -Z system
    class main
    user root
    group root wifi inet sdcard_rw media_rw diag
    disabled
    oneshot

service sniffer /vendor/bin/tcpdump_vendor -i wlan0 -w /data/vendor/wlan_logs/sniffer.pcap
    class main
    user root
    group root
    disabled
    oneshot

on property:persist.vendor.tcpdump.enable=true
    start vendor.tcpdump

on property:persist.vendor.tcpdump.enable=false
    stop vendor.tcpdump

on property:persist.sys.cota.carrier=OR
    stop vendor.tcpdump

#add cnss_diag root
on property:persist.vendor.cnss_diag.enable=true
   start vendor.cnss_diag

